<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <Label Text="GRAND HOTEL"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   HorizontalOptions="Center"
                   Margin="0,10"
                   CharacterSpacing="2"/>

            <VerticalStackLayout Spacing="8">
                <Label Text="Acomodação:" TextColor="#A0A0A0"/>
                <Border BackgroundColor="#1E1E1E"
                        Padding="5"
                        Stroke="#D4AF37"
                        StrokeThickness="2">
                    <Picker x:Name="pck_suite"
                            Title="Selecione a suíte"
                            TextColor="White"
                            TitleColor="Gray">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Suíte Master Luxo</x:String>
                                <x:String>Executiva Superior</x:String>
                                <x:String>Standard Comfort</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Check-in" TextColor="#A0A0A0" FontSize="12"/>
                    <DatePicker x:Name="dtp_checkin" Format="dd/MM/yyyy" TextColor="White"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Check-out" TextColor="#A0A0A0" FontSize="12"/>
                    <DatePicker x:Name="dtp_checkout" Format="dd/MM/yyyy" TextColor="White"/>
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#1E1E1E"
                    Padding="15"
                    Stroke="#333"
                    StrokeThickness="1">
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Label Text="Hóspedes:" TextColor="White" VerticalOptions="Center"/>
                    <Stepper x:Name="stp_adultos" Minimum="1" Maximum="10" Value="1"/>
                    <Label Text="{Binding Source={x:Reference stp_adultos}, Path=Value}"
                           TextColor="#D4AF37" FontSize="26" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Border>

            <Button Text="CONFIRMAR RESERVA"
                    Clicked="OnConfirmarClicked"
                    BackgroundColor="#D4AF37"
                    TextColor="Black"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    CornerRadius="10"/>

            <Button Text="Sobre o Desenvolvedor"
                    Clicked="OnConfirmarClicked"
                    BackgroundColor="Transparent"
                    TextColor="#707070"
                    FontSize="12"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>