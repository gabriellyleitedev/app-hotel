<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Sobre"
             BackgroundColor="#121212" Title="Reserva Confirmada">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        
        <Label Text="✔" TextColor="#D4AF37" FontSize="80" HorizontalOptions="Center" />
        
        <Label Text="PARABÉNS!" TextColor="#D4AF37" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Sua reserva foi confirmada com sucesso." TextColor="White" HorizontalOptions="Center" Margin="0,0,0,20" />

        <Border BackgroundColor="#1E1E1E" Stroke="#D4AF37" Padding="20" StrokeThickness="2">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="lbl_suite" TextColor="White" FontSize="18" FontAttributes="Bold" />
                <BoxView HeightRequest="1" BackgroundColor="#333" />
                <Label x:Name="lbl_periodo" TextColor="Gray" />
                <Label x:Name="lbl_hospedes" TextColor="Gray" />
            </VerticalStackLayout>
        </Border>

        <Button Text="NOVA RESERVA" Clicked="Button_Clicked" 
                BackgroundColor="#D4AF37" TextColor="Black" FontAttributes="Bold" Margin="0,20" />

    </VerticalStackLayout>
</ContentPage>