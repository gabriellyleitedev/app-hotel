<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.Sobre"
             BackgroundColor="#121212"
        Title="Reserva Confirmada">

    <VerticalStackLayout Padding="30"
            Spacing="20"
            VerticalOptions="Center">

        <Label Text="✔"
                TextColor="#D4AF37"
                FontSize="70"
                HorizontalOptions="Center"/>
        <Label Text="RESERVA CONFIRMADA"
                TextColor="#D4AF37"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

        <Frame BackgroundColor="#1E1E1E"
                BorderColor="#D4AF37"
                Padding="20"
                CornerRadius="10">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="lbl_suite"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"/>
                <BoxView HeightRequest="1"
                        BackgroundColor="#333"/>

                <Label x:Name="lbl_periodo"
                        TextColor="#A0A0A0"
                        FontSize="14"/>
                <Label x:Name="lbl_dias"
                        TextColor="#A0A0A0"
                        FontSize="14"/>
                <Label x:Name="lbl_hospedes"
                        TextColor="#A0A0A0"
                        FontSize="14"/>

                <BoxView HeightRequest="1"
                        BackgroundColor="#333"/>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="VALOR TOTAL:"
                            TextColor="White"
                            FontAttributes="Bold"
                            VerticalOptions="Center"/>
                    <Label x:Name="lbl_valor"
                            TextColor="#D4AF37"
                            FontSize="22"
                            FontAttributes="Bold"
                            VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <Button Text="NOVA RESERVA"
                Clicked="Button_Clicked"
                BackgroundColor="#D4AF37"
                TextColor="Black"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10"/>

    </VerticalStackLayout>
</ContentPage>